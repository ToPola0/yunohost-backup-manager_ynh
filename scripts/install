#!/bin/bash
set -e
source /usr/share/yunohost/helpers
# Data is managed separately to avoid deleting credentials during upgrades.
cp ../sources/app.py "$install_dir/app.py"
cp ../sources/cron_schedule.py "$install_dir/cron_schedule.py"
cp ../sources/resumable_chunks.py "$install_dir/resumable_chunks.py"
cp ../sources/orphan_cleanup.py "$install_dir/orphan_cleanup.py"
cp ../sources/smb_transport.py "$install_dir/smb_transport.py"
cp ../sources/updater.py "$install_dir/updater.py"
cp ../sources/update_runner.py "$install_dir/update_runner.py"
cp ../sources/logo.png "$install_dir/logo.png"
ln -s "$data_dir" "$install_dir/data"
chmod 700 "$data_dir"
python3 -m venv "$install_dir/venv"
"$install_dir/venv/bin/pip" install --disable-pip-version-check 'Flask==3.1.3' 'cryptography' 'smbprotocol==1.17.0' 'pysmb' 'gunicorn'
ynh_config_add_nginx
ynh_config_add_systemd
systemctl daemon-reload
systemctl enable "$app"
systemctl restart "$app"
# Set only this app's logo in the YunoHost application/permission metadata.
# This is optional presentation metadata, never a reason to fail an app upgrade.
if ! yunohost user permission update "${app}.main" --logo "$install_dir/logo.png"; then
    echo "UWAGA: YunoHost nie zaktualizował ikony tej aplikacji." >&2
fi

