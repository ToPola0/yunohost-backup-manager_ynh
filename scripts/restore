#!/bin/bash
source /usr/share/yunohost/helpers
mkdir -p "$install_dir/data"
ynh_restore_file --origin_path="$install_dir/data" --not_mandatory
cp ../sources/app.py "$install_dir/app.py"
python3 -m venv "$install_dir/venv"
"$install_dir/venv/bin/pip" install --disable-pip-version-check 'Flask==3.1.3' 'cryptography' 'smbprotocol==1.17.0' 'pysmb' 'gunicorn'
chmod 700 "$install_dir/data"
ynh_add_nginx_config
ynh_add_systemd_config
systemctl daemon-reload
systemctl enable --now "$app"
