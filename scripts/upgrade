#!/bin/bash
set -e
source /usr/share/yunohost/helpers
cp ../sources/app.py "$install_dir/app.py"
cp ../sources/smb_transport.py "$install_dir/smb_transport.py"
cp ../sources/updater.py "$install_dir/updater.py"
cp ../sources/update_runner.py "$install_dir/update_runner.py"
cp ../sources/logo.png "$install_dir/logo.png"
# Fatal when YunoHost does not replace the actual installed files.
for file in app.py smb_transport.py updater.py update_runner.py logo.png; do
    if ! cmp -s "../sources/$file" "$install_dir/$file"; then
        echo "BŁĄD: instalowany plik $file nie jest zgodny z pakietem aktualizacji." >&2
        exit 1
    fi
done
if [ ! -L "$install_dir/data" ]; then
    echo "Expected managed data directory symlink missing; refusing unsafe upgrade" >&2
    exit 1
fi
# If GitHub or YunoHost supplied stale code, fail instead of reporting success.
expected_version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' ../manifest.toml | head -n 1)
installed_version=$(sed -n "s/^APP_VERSION = '\([^']*\)'/\1/p" "$install_dir/updater.py" | head -n 1)
if [ -z "$expected_version" ] || [ "$expected_version" != "$installed_version" ]; then
    echo "BŁĄD: niespójna wersja manifestu ($expected_version) i kodu ($installed_version)." >&2
    exit 1
fi
python3 -m venv "$install_dir/venv"
"$install_dir/venv/bin/pip" install --disable-pip-version-check 'Flask==3.1.3' 'cryptography' 'smbprotocol==1.17.0' 'pysmb' 'gunicorn'
ynh_config_add_nginx
ynh_config_add_systemd
systemctl daemon-reload
systemctl enable "$app"
systemctl restart "$app"
# Set only this app's logo in the YunoHost application/permission metadata.
# This is optional presentation metadata, never a reason to fail an app upgrade.
if ! yunohost user permission update "${app}.main" --logo "$install_dir/logo.png"; then
    echo "UWAGA: YunoHost nie zaktualizował ikony tej aplikacji." >&2
fi

